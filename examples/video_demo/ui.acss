/* YouTube-style Video Player - Enhanced Styles */

:root {
    --bg-base: #0f0f0f;
    --bg-elevated: #1a1a1a;
    --bg-surface: #212121;
    --bg-hover: #3f3f3f;

    --text-primary: #f1f1f1;
    --text-secondary: #aaaaaa;
    --text-tertiary: #717171;

    --red-primary: #ff0000;
    --blue-link: #3ea6ff;
}

/* ==================== ROOT ==================== */
#root {
    width: 100vw;
    height: 100vh;
    background-color: var(--bg-base);
    flex-direction: column;
}

/* ==================== HEADER ==================== */
#header {
    width: 100%;
    height: 56px;
    background-color: var(--bg-base);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
}

#header-left {
    flex-direction: row;
    align-items: center;
    gap: 16px;
}

#menu-icon {
    width: 24px;
    height: 18px;
    flex-direction: column;
    justify-content: space-between;
    padding: 2px 0;
}

.menu-line {
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
}

#logo {
    color: var(--text-primary);
}

#search-wrapper {
    width: 45%;
    height: 40px;
    flex-direction: row;
}

#search-box {
    width: 85%;
    height: 100%;
    background-color: var(--bg-base);
    padding: 0 16px;
}

#search-button {
    width: 64px;
    height: 100%;
    background-color: var(--bg-surface);
    justify-content: center;
    align-items: center;
}

.search-icon {
    color: var(--text-primary);
}

#header-right {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.header-icon-btn {
    width: 40px;
    height: 40px;
    justify-content: center;
    align-items: center;
}

#user-avatar {
    width: 32px;
    height: 32px;
    background-color: #6b5ce7;
    justify-content: center;
    align-items: center;
    margin: 0 0 0 8px;
}

#user-initial {
    color: var(--text-primary);
}

/* ==================== MAIN ==================== */
#main-wrapper {
    width: 100%;
    height: 92vh;
    flex-direction: row;
    padding: 0 24px 24px 24px;
    gap: 24px;
}

#main-column {
    width: 70%;
    height: 100%;
    flex-direction: column;
}

#main-scroll-content {
    width: 100%;
    flex-direction: column;
    gap: 12px;
    padding: 0 12px 0 0;
}

#video-container {
    width: 100%;
    height: 480px;
    background-color: #000000;
}

#video-player {
    width: 100%;
    height: 100%;
}

/* ==================== VIDEO INFO ==================== */
#video-info-section {
    width: 100%;
    flex-direction: column;
    gap: 12px;
    padding: 12px 0;
}

#video-title {
    color: var(--text-primary);
}

#stats-actions-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

#stats-left {
    flex-direction: row;
    align-items: center;
    gap: 6px;
}

.stats-text {
    color: var(--text-secondary);
}

.stats-dot {
    color: var(--text-tertiary);
}

#actions-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.action-btn {
    height: 36px;
    background-color: var(--bg-surface);
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    gap: 6px;
}

.action-btn-full {
    height: 36px;
    background-color: var(--bg-surface);
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    gap: 6px;
}

.action-separator {
    width: 1px;
    height: 24px;
    background-color: var(--bg-hover);
}

.action-icon {
    color: var(--text-primary);
}

.action-text {
    color: var(--text-primary);
}

/* ==================== CHANNEL ==================== */
#channel-section {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
}

#channel-left {
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

#channel-avatar {
    width: 40px;
    height: 40px;
    background-color: #c0392b;
    justify-content: center;
    align-items: center;
}

#channel-initial {
    color: var(--text-primary);
}

#channel-meta {
    flex-direction: column;
    gap: 2px;
}

#channel-name {
    color: var(--text-primary);
}

#subscriber-count {
    color: var(--text-secondary);
}

#subscribe-btn {
    height: 36px;
    width: 110px;
    background-color: var(--text-primary);
}

/* ==================== DESCRIPTION ==================== */
#description-card {
    width: 100%;
    background-color: var(--bg-surface);
    padding: 12px;
    flex-direction: column;
    gap: 8px;
}

#desc-stats {
    flex-direction: row;
    gap: 8px;
}

.desc-stat {
    color: var(--text-primary);
}

.desc-tag {
    color: var(--blue-link);
}

#desc-text {
    color: var(--text-primary);
}

#desc-more {
    color: var(--text-secondary);
}

/* ==================== COMMENTS ==================== */
#comments-section {
    width: 100%;
    flex-direction: column;
    gap: 20px;
    padding: 16px 0 0 0;
}

#comments-header {
    flex-direction: row;
    align-items: center;
    gap: 32px;
}

#comments-count {
    color: var(--text-primary);
}

#sort-btn {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.sort-icon {
    color: var(--text-primary);
}

.sort-text {
    color: var(--text-primary);
}

#add-comment-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 0 0 16px 0;
}

.comment-avatar-small {
    width: 36px;
    height: 36px;
    background-color: #6b5ce7;
    justify-content: center;
    align-items: center;
}

#comments-list {
    flex-direction: column;
    gap: 16px;
}

.comment-item {
    width: 100%;
    flex-direction: row;
    gap: 12px;
}

.comment-avatar {
    width: 40px;
    height: 40px;
    background-color: #2563eb;
    justify-content: center;
    align-items: center;
}

.avatar-letter {
    color: var(--text-primary);
}

.comment-body {
    flex-direction: column;
    gap: 4px;
    width: 90%;
}

.comment-meta {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.comment-author {
    color: var(--text-primary);
}

.comment-time {
    color: var(--text-tertiary);
}

.comment-text {
    color: var(--text-primary);
}

.comment-actions {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    padding: 4px 0 0 0;
}

.comment-action {
    color: var(--text-secondary);
}

.comment-reply-btn {
    color: var(--text-secondary);
}

/* ==================== SIDEBAR ==================== */
#sidebar {
    width: 30%;
    height: 100%;
    flex-direction: column;
}

#sidebar-content {
    width: 100%;
    flex-direction: column;
    gap: 8px;
}

#related-header {
    flex-direction: row;
    gap: 8px;
    padding: 0 0 12px 0;
}

.chip {
    height: 32px;
    background-color: var(--bg-surface);
    padding: 0 12px;
    justify-content: center;
    align-items: center;
}

.chip.active {
    background-color: var(--text-primary);
}

.chip-text {
    color: var(--text-primary);
}

.related-card {
    width: 100%;
    flex-direction: row;
    gap: 8px;
    padding: 4px 0;
}

.thumb {
    width: 168px;
    height: 94px;
    min-width: 168px;
    background-color: #2d3748;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 4px;
}

.thumb-overlay {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.1);
}

.duration {
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 4px;
}

.duration-text {
    color: var(--text-primary);
}

.card-info {
    flex-direction: column;
    gap: 4px;
    padding: 2px 0 0 0;
}

.card-title {
    color: var(--text-primary);
}

.card-channel {
    color: var(--text-secondary);
}

.card-stats {
    color: var(--text-tertiary);
}
