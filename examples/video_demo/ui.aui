<!-- YouTube-style Video Player Layout - Enhanced UI -->
<container id="root">
    <!-- Header -->
    <container id="header">
        <!-- Left Section -->
        <container id="header-left">
            <container id="menu-icon">
                <container class="menu-line" />
                <container class="menu-line" />
                <container class="menu-line" />
            </container>
            <text id="logo" size="22">▶ arepy</text>
        </container>

        <!-- Center - Search -->
        <container id="search-wrapper">
            <container id="search-box">
                <input id="search-input" placeholder="Search videos..." width="100%" height="100%" />
            </container>
            <container id="search-button">
                <text class="search-icon" size="16">[O]</text>
            </container>
        </container>

        <!-- Right Section -->
        <container id="header-right">
            <container class="header-icon-btn">
                <text size="18">[--]</text>
            </container>
            <container class="header-icon-btn">
                <text size="18">[/]</text>
            </container>
            <container id="user-avatar">
                <text id="user-initial" size="14">A</text>
            </container>
        </container>
    </container>

    <!-- Main Content Wrapper -->
    <container id="main-wrapper">
        <!-- Main Column -->
        <container id="main-column">
            <scroll id="main-scroll" width="100%" height="100%">
                <container id="main-scroll-content">
                    <!-- Video Player Container -->
                    <container id="video-container">
                        <video id="video-player"
                               src="examples/assets/dispatch.mp4"
                               width="100%"
                               height="100%"
                               autoplay="true"
                               loop="true" />
                    </container>

                    <!-- Video Info Section -->
                    <container id="video-info-section">
                        <!-- Title -->
                        <text id="video-title" size="20">Building a YouTube-like Video Player with arepy-ui</text>

                        <!-- Stats and Actions Row -->
                        <container id="stats-actions-row">
                            <container id="stats-left">
                                <text class="stats-text" size="14">1,234,567 views</text>
                                <text class="stats-dot" size="14">•</text>
                                <text class="stats-text" size="14">Dec 5, 2025</text>
                            </container>

                            <container id="actions-row">
                                <container class="action-btn">
                                    <text class="action-icon" size="16">Like</text>
                                    <text class="action-text" size="13">123K</text>
                                </container>
                                <container class="action-separator" />
                                <container class="action-btn" on-click="on_dislike">
                                    <text class="action-icon" size="16">Dislike</text>
                                </container>
                                <container class="action-btn-full" on-click="on_share">
                                    <text class="action-icon" size="14">↗</text>
                                    <text class="action-text" size="13">Share</text>
                                </container>
                                <container class="action-btn-full" on-click="on_save">
                                    <text class="action-text" size="13">Save</text>
                                </container>
                                <container class="action-btn-full">
                                    <text class="action-icon" size="14">•••</text>
                                </container>
                            </container>
                        </container>
                    </container>

                    <!-- Channel Section -->
                    <container id="channel-section">
                        <container id="channel-left">
                            <container id="channel-avatar">
                                <text id="channel-initial" size="18">A</text>
                            </container>
                            <container id="channel-meta">
                                <text id="channel-name" size="16">Arepy UI Official</text>
                                <text id="subscriber-count" size="12">15.2K subscribers</text>
                            </container>
                        </container>
                        <button id="subscribe-btn" on-click="on_subscribe">Subscribe</button>
                    </container>

                    <!-- Description Card -->
                    <container id="description-card">
                        <container id="desc-stats">
                            <text class="desc-stat" size="13">1.2M views</text>
                            <text class="desc-stat" size="13">3 days ago</text>
                            <text class="desc-tag" size="13">#python</text>
                            <text class="desc-tag" size="13">#gamedev</text>
                            <text class="desc-tag" size="13">#ui</text>
                        </container>
                        <text id="desc-text" size="14">This demo showcases the Video component of arepy-ui with full playback controls, responsive layout using viewport units, ScrollView for content, and a clean YouTube-inspired design.</text>
                        <text id="desc-more" size="13">...more</text>
                    </container>

                    <!-- Comments Section -->
                    <container id="comments-section">
                        <container id="comments-header">
                            <text id="comments-count" size="16">128 Comments</text>
                            <container id="sort-btn">
                                <text class="sort-icon" size="12">☰</text>
                                <text class="sort-text" size="13">Sort by</text>
                            </container>
                        </container>

                        <!-- Add Comment -->
                        <container id="add-comment-row">
                            <container class="comment-avatar-small">
                                <text class="avatar-letter" size="12">A</text>
                            </container>
                            <input id="comment-input" placeholder="Add a comment..." width="100%" height="36px" />
                        </container>

                        <!-- Comments List -->
                        <container id="comments-list">
                            <container class="comment-item">
                                <container class="comment-avatar">
                                    <text class="avatar-letter" size="14">P</text>
                                </container>
                                <container class="comment-body">
                                    <container class="comment-meta">
                                        <text class="comment-author" size="13">@pythondev</text>
                                        <text class="comment-time" size="12">2 hours ago</text>
                                    </container>
                                    <text class="comment-text" size="14">This is exactly what I needed! Great work on the UI framework.</text>
                                    <container class="comment-actions">
                                        <text class="comment-action" size="13">👍 245</text>
                                        <text class="comment-action" size="13">👎</text>
                                        <text class="comment-reply-btn" size="13">Reply</text>
                                    </container>
                                </container>
                            </container>

                            <container class="comment-item">
                                <container class="comment-avatar" style="background-color: #2d5a27;">
                                    <text class="avatar-letter" size="14">G</text>
                                </container>
                                <container class="comment-body">
                                    <container class="comment-meta">
                                        <text class="comment-author" size="13">@gamedev_pro</text>
                                        <text class="comment-time" size="12">5 hours ago</text>
                                    </container>
                                    <text class="comment-text" size="14">The video controls are smooth. How did you handle the frame timing?</text>
                                    <container class="comment-actions">
                                        <text class="comment-action" size="13">👍 89</text>
                                        <text class="comment-action" size="13">👎</text>
                                        <text class="comment-reply-btn" size="13">Reply</text>
                                    </container>
                                </container>
                            </container>

                            <container class="comment-item">
                                <container class="comment-avatar" style="background-color: #7c3aed;">
                                    <text class="avatar-letter" size="14">U</text>
                                </container>
                                <container class="comment-body">
                                    <container class="comment-meta">
                                        <text class="comment-author" size="13">@ui_enthusiast</text>
                                        <text class="comment-time" size="12">1 day ago</text>
                                    </container>
                                    <text class="comment-text" size="14">Love the attention to detail on the scrollbars and hover effects! 👏</text>
                                    <container class="comment-actions">
                                        <text class="comment-action" size="13">👍 156</text>
                                        <text class="comment-action" size="13">👎</text>
                                        <text class="comment-reply-btn" size="13">Reply</text>
                                    </container>
                                </container>
                            </container>

                            <container class="comment-item">
                                <container class="comment-avatar" style="background-color: #dc2626;">
                                    <text class="avatar-letter" size="14">C</text>
                                </container>
                                <container class="comment-body">
                                    <container class="comment-meta">
                                        <text class="comment-author" size="13">@coding_wizard</text>
                                        <text class="comment-time" size="12">2 days ago</text>
                                    </container>
                                    <text class="comment-text" size="14">Finally a good UI library for Python games. Subscribed!</text>
                                    <container class="comment-actions">
                                        <text class="comment-action" size="13">👍 312</text>
                                        <text class="comment-action" size="13">👎</text>
                                        <text class="comment-reply-btn" size="13">Reply</text>
                                    </container>
                                </container>
                            </container>
                        </container>
                    </container>
                </container>
            </scroll>
        </container>

        <!-- Sidebar -->
        <container id="sidebar">
            <scroll id="sidebar-scroll" width="100%" height="100%">
                <container id="sidebar-content">
                    <!-- Related Videos Header -->
                    <container id="related-header">
                        <container class="chip active">
                            <text class="chip-text" size="12">All</text>
                        </container>
                        <container class="chip">
                            <text class="chip-text" size="12">Related</text>
                        </container>
                        <container class="chip">
                            <text class="chip-text" size="12">Recently uploaded</text>
                        </container>
                    </container>

                    <!-- Video Cards -->
                    <container class="related-card">
                        <container class="thumb">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">2:15:30</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">Python Game Development - Complete Course 2025</text>
                            <text class="card-channel" size="12">GameDev Academy</text>
                            <text class="card-stats" size="11">892K views • 2 weeks ago</text>
                        </container>
                    </container>

                    <container class="related-card">
                        <container class="thumb" style="background-color: #1a365d;">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">45:12</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">Building UIs with Flexbox - Deep Dive</text>
                            <text class="card-channel" size="12">CSS Master</text>
                            <text class="card-stats" size="11">234K views • 1 month ago</text>
                        </container>
                    </container>

                    <container class="related-card">
                        <container class="thumb" style="background-color: #7c2d12;">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">18:45</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">Raylib - Performance Comparison</text>
                            <text class="card-channel" size="12">Code Compare</text>
                            <text class="card-stats" size="11">156K views • 3 days ago</text>
                        </container>
                    </container>

                    <container class="related-card">
                        <container class="thumb" style="background-color: #164e63;">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">32:20</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">Create a Music Player in Python</text>
                            <text class="card-channel" size="12">PyTutorials</text>
                            <text class="card-stats" size="11">67K views • 1 week ago</text>
                        </container>
                    </container>

                    <container class="related-card">
                        <container class="thumb" style="background-color: #4c1d95;">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">1:05:00</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">Advanced Python Patterns for Games</text>
                            <text class="card-channel" size="12">Pro Coder</text>
                            <text class="card-stats" size="11">445K views • 2 months ago</text>
                        </container>
                    </container>

                    <container class="related-card">
                        <container class="thumb" style="background-color: #065f46;">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">28:15</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">UI Animation Techniques</text>
                            <text class="card-channel" size="12">Motion Design</text>
                            <text class="card-stats" size="11">123K views • 5 days ago</text>
                        </container>
                    </container>

                    <container class="related-card">
                        <container class="thumb" style="background-color: #991b1b;">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">22:40</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">Python Performance Tips 2025</text>
                            <text class="card-channel" size="12">Speed Demon</text>
                            <text class="card-stats" size="11">89K views • 1 day ago</text>
                        </container>
                    </container>

                    <container class="related-card">
                        <container class="thumb" style="background-color: #1e3a5f;">
                            <container class="thumb-overlay" />
                            <container class="duration">
                                <text class="duration-text" size="11">1:45:00</text>
                            </container>
                        </container>
                        <container class="card-info">
                            <text class="card-title" size="13">Building a Video Editor in Python</text>
                            <text class="card-channel" size="12">Creative Code</text>
                            <text class="card-stats" size="11">234K views • 2 weeks ago</text>
                        </container>
                    </container>
                </container>
            </scroll>
        </container>
    </container>
</container>
