/* Variables */
:root {
    --bg-dark: #1e1e2e;
    --text-primary: #ffffff;
    --text-secondary: #a0a0a0;
    --primary: #007acc;
    --secondary: #6c757d;
    --danger: #dc3545;
    --spacing: 20px;
}

/* Root container - full screen centered */
.main {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 30px;
    background: var(--bg-dark);
}

/* Title styling */
.title {
    font-size: 36px;
    color: var(--text-primary);
}

/* Content area */
.content {
    gap: 20px;
    align-items: center;
}

/* Counter display */
.counter {
    font-size: 24px;
    color: var(--text-primary);
}

/* Button row */
.buttons {
    gap: 15px;
    justify-content: center;
}

/* Base button style */
.btn {
    width: 80px;
    height: 45px;
    border-radius: 8px;
    font-size: 16px;
    color: var(--text-primary);
}

/* Button variants */
.btn-primary {
    background: var(--primary);
}

.btn-secondary {
    background: var(--secondary);
}

.btn-danger {
    background: var(--danger);
}

/* Footer text */
.footer {
    font-size: 20px;
    color: var(--text-secondary);
    position: absolute;
    bottom: 20px;
}
